            "draftMessage/Subject": "@triggerOutputs()?['body/subject']",
            "draftMessage/Body": "<p class=\"editor-paragraph\">@{outputs('Draft_-_Generate_Reply')?['body/responsev2/predictionOutput/text']}</p>",
